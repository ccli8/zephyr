# TrustZone
CONFIG_ARM_TRUSTZONE_M=y
CONFIG_TRUSTED_EXECUTION_SECURE=y
CONFIG_ARM_FIRMWARE_HAS_SECURE_ENTRY_FUNCS=y
CONFIG_ARM_SECURE_BUSFAULT_HARDFAULT_NMI=y
CONFIG_USE_DT_CODE_PARTITION=y
# Thread dependent log mode (CONFIG_LOG_MODE_DEFERRED) relies on
# scheduler, which can shut down after control is handed over.
CONFIG_LOG_MODE_MINIMAL=y

CONFIG_GPIO=y

# Enable system clock controller driver
CONFIG_CLOCK_CONTROL=y
CONFIG_CLOCK_CONTROL_NUMAKER_SCC=y

# Enable UART driver
CONFIG_SERIAL=y
# When any Non-Secure UART is shared between SPE and NSPE,
# Non-Secure UART interrupt cannot be supported in SPE.
CONFIG_UART_INTERRUPT_DRIVEN=n

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
